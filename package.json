{
  "name": "castellano",
  "description": "Mensajes en castellano para algunos módulos de node.js",
  "version": "0.1.8",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/castellano",
  "license": "MIT",
  "main": "lib/cliente-en-castellano.js",
  "files": [
    "lib"
  ],
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "require-bro": "^0.4.1",
    "best-globals": "^2.2.3",
    "dialog-promise": "^0.11.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "qa-control": "^0.14.1",
    "server4test": "^2.0.0"
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build-test": "nyc instrument --delete lib local-instrumented/lib",
    "test": "npm run test-navigator",
    "test-ci": "npm run test-navigator && nyc report --reporter=lcov --reporter=text",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test"
  },
  "qa-control": {
    "run-in": "client",
    "type": "lib",
    "gha": "all"
  }
}
